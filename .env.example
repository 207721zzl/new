# EvidenceRAG
APP_NAME=EvidenceRAG
APP_VERSION=1.0.0
APP_ENVIRONMENT=development
APP_TIMEZONE=Asia/Shanghai

# Logging and local model lifecycle
LOG_LEVEL=INFO
LOG_DIR=logs
MODEL_PRELOAD_ENABLED=true
MODEL_WARMUP_ENABLED=true
MODEL_PRELOAD_FAIL_FAST=false
INFERENCE_QUEUE_TIMEOUT_SECONDS=30

# Answer generation and optional query rewriting
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=60
DEEPSEEK_MAX_RETRIES=2
DEEPSEEK_MAX_TOKENS=1200
DEEPSEEK_TEMPERATURE=0.1
DEEPSEEK_THINKING_ENABLED=false
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_MAX_TOKENS=300
QUERY_REWRITE_TEMPERATURE=0
CONVERSATION_RECENT_TURNS=12
CONVERSATION_CONTEXT_MAX_CHARS=12000

# Authentication and server-side sessions
AUTH_REGISTRATION_ENABLED=true
AUTH_SESSION_ABSOLUTE_HOURS=12
AUTH_SESSION_IDLE_MINUTES=60
AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15
AUTH_COOKIE_SAMESITE=lax
AUTH_SESSION_COOKIE_NAME=evidence_rag_session
AUTH_CSRF_COOKIE_NAME=evidence_rag_csrf
# 留空时按请求协议自动判断；固定 HTTPS 生产环境建议显式设为 true。
# AUTH_COOKIE_SECURE=true

# Single-host pilot operations and retention
PILOT_METRICS_WINDOW_HOURS=24
PILOT_STALE_TASK_MINUTES=30
PILOT_RECONCILE_INTERRUPTED_TASKS=true
PILOT_CONVERSATION_RETENTION_DAYS=90
PILOT_SESSION_RETENTION_DAYS=30
PILOT_AUDIT_RETENTION_DAYS=365
PILOT_RATE_LIMIT_ENABLED=true
PILOT_LOGIN_REQUESTS_PER_5_MINUTES=20
PILOT_REGISTRATION_REQUESTS_PER_HOUR=10
PILOT_QUERY_REQUESTS_PER_MINUTE=30
PILOT_UPLOAD_REQUESTS_PER_HOUR=20

# MySQL: document/parent chunk truth source, conversations and job state
MYSQL_HOST_PORT=13306
MYSQL_DATABASE=evidence_rag
MYSQL_USER=evidence_rag
MYSQL_PASSWORD=evidence_rag
MYSQL_ROOT_PASSWORD=evidence_rag_root
MYSQL_READ_USER=evidence_reader
MYSQL_READ_PASSWORD=evidence_reader
DATABASE_URL=mysql+asyncmy://evidence_rag:evidence_rag@127.0.0.1:13306/evidence_rag?charset=utf8mb4
DATABASE_READ_URL=mysql+asyncmy://evidence_reader:evidence_reader@127.0.0.1:13306/evidence_rag?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_ECHO=false
DATABASE_READ_EXPECTED_USER=evidence_reader

# Milvus Dense + BM25 hybrid retrieval
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=evidence_rag_knowledge
MILVUS_HOST_PORT=19530
MILVUS_HEALTH_HOST_PORT=19091
MINIO_API_HOST_PORT=19000
MINIO_CONSOLE_HOST_PORT=19001

# Local embedding and cross-encoder reranker
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=16
RETRIEVAL_TOP_K=5
HYBRID_CANDIDATE_TOP_K=8
HYBRID_RRF_K=60
MILVUS_SEARCH_TIMEOUT_SECONDS=10
DENSE_SEARCH_EF=64
RERANKER_MODEL=BAAI/bge-reranker-large
RERANKER_DEVICE=auto
RERANKER_BATCH_SIZE=8
RERANKER_MAX_LENGTH=512
RERANKER_USE_FAST_TOKENIZER=true
RERANKER_NORMALIZE=true
RERANKER_MIN_SCORE=0.1
BGE_M3_HOST_PATH=D:/model
RERANKER_HOST_PATH=D:/bge-reranker-large
HF_TOKEN=
HF_HUB_DISABLE_XET=true
HF_HUB_DOWNLOAD_TIMEOUT=300

# Ingestion, structure-aware parent chunks and overlapping child chunks
KNOWLEDGE_SOURCE_FILE=data/knowledge/example.json
KNOWLEDGE_PARENT_CHUNK_SIZE=1600
KNOWLEDGE_PARENT_CHUNK_OVERLAP=0
KNOWLEDGE_CHILD_CHUNK_SIZE=400
KNOWLEDGE_CHILD_CHUNK_OVERLAP=80
KNOWLEDGE_UPLOAD_MAX_FILES=20
KNOWLEDGE_UPLOAD_MAX_FILE_BYTES=20971520
KNOWLEDGE_UPLOAD_MAX_BATCH_BYTES=104857600
KNOWLEDGE_UPLOAD_PARSE_TIMEOUT_SECONDS=60
KNOWLEDGE_UPLOAD_MAX_ARCHIVE_ENTRIES=5000
KNOWLEDGE_UPLOAD_MAX_UNCOMPRESSED_BYTES=536870912
KNOWLEDGE_UPLOAD_MAX_COMPRESSION_RATIO=100
KNOWLEDGE_INDEX_BATCH_SIZE=64
PDF_OCR_ENABLED=false
PDF_OCR_LANGUAGE=chi_sim+eng
PDF_OCR_DPI=200
EXCEL_ROWS_PER_BLOCK=25

# Docker host paths and ports
API_HOST_PORT=8000
DOCKER_VOLUME_DIRECTORY=.
