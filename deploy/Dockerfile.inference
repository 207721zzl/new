ARG PYTHON_IMAGE=m.daocloud.io/docker.io/pytorch/pytorch:2.12.1-cuda12.6-cudnn9-runtime
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
RUN pip install --break-system-packages --no-cache-dir fastapi==0.139.0 uvicorn==0.51.0 pydantic-settings==2.14.2 FlagEmbedding==1.4.0 'transformers>=4.44.2,<5' httpx==0.28.1
ENV PYTHONPATH=/app
COPY app/config.py app/errors.py app/logging_config.py ./app/
COPY app/rag ./app/rag
COPY packages ./packages
COPY services/inference ./services/inference
RUN mkdir -p logs
CMD ["uvicorn", "services.inference.api:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
