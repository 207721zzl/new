ARG PYTHON_IMAGE=m.daocloud.io/docker.io/pytorch/pytorch:2.12.1-cuda12.6-cudnn9-runtime
FROM ${PYTHON_IMAGE} AS base
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY deploy/requirements-cpu.txt /tmp/requirements.txt
RUN pip install --break-system-packages --no-cache-dir -r /tmp/requirements.txt
ENV PYTHONPATH=/app
COPY app ./app
COPY packages ./packages
COPY services ./services
COPY scripts ./scripts
COPY data/knowledge/example.json ./data/knowledge/example.json
RUN useradd --uid 10001 --create-home appuser && mkdir -p logs data/knowledge/uploads && chown -R appuser:appuser /app
USER appuser
EXPOSE 8000

FROM base AS ingestion
USER root
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr tesseract-ocr-chi-sim tesseract-ocr-eng && rm -rf /var/lib/apt/lists/*
USER appuser
